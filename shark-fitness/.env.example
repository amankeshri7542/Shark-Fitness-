# Local runtime
NODE_ENV=development
PORT=8787
SHARK_DB=./data/shark.db
SHARK_SERVE_STATIC=false
# Set true only on additional instances while the scheduler is single-leader.
SHARK_DISABLE_JOBS=false

# Browser origins. Production must use exact HTTPS origins, comma-separated.
SHARK_PUBLIC_ORIGIN=http://localhost:8787
SHARK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Generate with: openssl rand -base64 48
SHARK_PASS_SECRET=replace-with-at-least-48-random-bytes

# Reader credentials never belong in the member or admin frontend.
# Tenant and branch slugs restrict where each physical reader is accepted.
SHARK_READER_KEYS_JSON={"front-door-koramangala":{"key":"replace-with-a-long-random-reader-key","tenantSlug":"shark","branchSlugs":["koramangala"]}}

# Unsafe compatibility switches. Keep both false in production.
SHARK_ECHO_OTP=false
SHARK_ALLOW_BEARER_AUTH=false
# Number of trusted reverse-proxy hops. Keep 0 for a directly exposed server.
SHARK_TRUST_PROXY_HOPS=0

# Local demo reader only. Ignored when NODE_ENV=production.
SHARK_DEMO_READER_KEY=demo-reader-secret-change-me

# Reserved: non-empty values are rejected until an upload provider exists.
SHARK_MEDIA_BUCKET=

# Optional replaceable JSON error-reporting collector. Production requires HTTPS.
SHARK_ERROR_REPORTING_ENDPOINT=

# Deployment/image identifier included in logs, readiness and durable job runs.
SHARK_RELEASE=

# Bounded operational-history retention. Undelivered outbox rows and immutable
# business/audit ledgers are never eligible for this maintenance job.
SHARK_IDEMPOTENCY_RETENTION_DAYS=30
SHARK_OUTBOX_RETENTION_DAYS=7
SHARK_SESSION_RETENTION_DAYS=30
SHARK_OTP_RETENTION_HOURS=24
SHARK_ACCESS_WINDOW_RETENTION_HOURS=24
SHARK_AUTOMATION_RETENTION_DAYS=90
SHARK_JOB_RUN_RETENTION_DAYS=30
SHARK_PRUNE_BATCH_SIZE=1000
SHARK_PRUNE_MAX_BATCHES=10

# Sign-in code delivery. "log" prints codes to the console in development only;
# production refuses code sign-in on a channel whose provider is "log".
# SMS/WhatsApp: log | msg91 | twilio. Email: log | resend.
SHARK_OTP_SMS_PROVIDER=log
SHARK_OTP_EMAIL_PROVIDER=log
# Country code used when a stored phone has no "+" prefix.
SHARK_OTP_DEFAULT_COUNTRY_CODE=91
# MSG91 (India): DLT-approved OTP template containing ##OTP##.
SHARK_MSG91_AUTH_KEY=
SHARK_MSG91_TEMPLATE_ID=
# Twilio: set SHARK_TWILIO_CHANNEL=whatsapp for WhatsApp. WhatsApp needs an
# approved template (SHARK_TWILIO_CONTENT_SID) whose {{1}} is the code.
SHARK_TWILIO_ACCOUNT_SID=
SHARK_TWILIO_AUTH_TOKEN=
SHARK_TWILIO_FROM=
SHARK_TWILIO_CHANNEL=sms
SHARK_TWILIO_CONTENT_SID=
# Resend email.
SHARK_RESEND_API_KEY=
SHARK_OTP_EMAIL_FROM=
# Send limits (defaults shown).
SHARK_OTP_RESEND_COOLDOWN_SEC=30
SHARK_OTP_MAX_PER_DESTINATION_PER_DAY=10
SHARK_OTP_MAX_PER_IP_PER_HOUR=30
