# Local runtime
NODE_ENV=development
PORT=8787
SHARK_DB=./data/shark.db
SHARK_SERVE_STATIC=false
# Set true only on additional instances while the scheduler is single-leader.
SHARK_DISABLE_JOBS=false

# Browser origins. Production must use exact HTTPS origins, comma-separated.
SHARK_PUBLIC_ORIGIN=http://localhost:8787
SHARK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Generate with: openssl rand -base64 48
SHARK_PASS_SECRET=replace-with-at-least-48-random-bytes

# AES-256-GCM key for TOTP secrets and webhook signing secrets at rest.
# Required in production; 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Losing it invalidates every enrolled authenticator and webhook secret
# (docs/SECURITY.md "Key custody"). Unset in development uses a published key.
#SHARK_MFA_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Send the Content-Security-Policy as Content-Security-Policy-Report-Only
# instead of enforcing it. For rollout and debugging only (docs/SECURITY.md).
#SHARK_CSP_REPORT_ONLY=false

# Reader credentials never belong in the member or admin frontend.
# Tenant and branch slugs restrict where each physical reader is accepted.
SHARK_READER_KEYS_JSON={"front-door-koramangala":{"key":"replace-with-a-long-random-reader-key","tenantSlug":"shark","branchSlugs":["koramangala"]}}

# Unsafe compatibility switches. Keep both false in production.
SHARK_ECHO_OTP=false
SHARK_ALLOW_BEARER_AUTH=false
# Number of trusted reverse-proxy hops. Keep 0 for a directly exposed server.
SHARK_TRUST_PROXY_HOPS=0

# Local demo reader only. Ignored when NODE_ENV=production.
SHARK_DEMO_READER_KEY=demo-reader-secret-change-me

# Reserved: non-empty values are rejected until an upload provider exists.
SHARK_MEDIA_BUCKET=

# Error reporting (docs/OPERATIONS-ALERTS.md). SHARK_ERROR_REPORTER picks the
# reporter: auto | none | console | http | sentry. "auto" (the default) uses
# SHARK_ERROR_DSN when set, then SHARK_ERROR_REPORTING_ENDPOINT, then console in
# development, otherwise none. Leave an unused line commented out: an empty
# value is refused at boot.
#SHARK_ERROR_REPORTER=auto
# Sentry-protocol DSN from Sentry, GlitchTip or any compatible collector.
# HTTPS is required in production. Only redacted messages and stack frames,
# release, environment, request id, route and tenant/actor ids are sent.
#SHARK_ERROR_DSN=https://replace-with-public-key@errors.example.com/1
# Plain JSON collector (for example a private ntfy.sh topic). HTTPS in production.
#SHARK_ERROR_REPORTING_ENDPOINT=https://errors.example.com/replace-me

# Prometheus metrics at GET /metrics, bearer-protected. Unset = 404.
# At least 32 characters in production. Generate with: openssl rand -hex 32
#SHARK_METRICS_TOKEN=replace-with-at-least-32-random-characters

# Online payments through Razorpay, TEST MODE ONLY (docs/PAYMENTS-RAZORPAY.md).
# Unset or "none" keeps today's behaviour: members pay at reception and staff
# record the money. "razorpay" needs all three credentials below, or boot is
# refused. Any key id that does not start with rzp_test_ is refused in every
# environment: live mode is out of scope for this release.
#SHARK_PAYMENT_PROVIDER=razorpay
# Dashboard (Test Mode) -> Account & Settings -> API Keys.
#SHARK_RAZORPAY_KEY_ID=rzp_test_replace_me
#SHARK_RAZORPAY_KEY_SECRET=replace-with-test-key-secret
# The secret you type when adding the webhook in the Dashboard (16+ characters
# in production). Webhook URL: <SHARK_PUBLIC_ORIGIN>/v1/webhooks/razorpay
#SHARK_RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Tests and the E2E harness only: point the adapter at a local fake Razorpay.
# Only https://api.razorpay.com/v1 or a loopback URL is accepted.
#SHARK_RAZORPAY_API_BASE=http://127.0.0.1:18150/v1

# Deployment/image identifier included in logs, readiness, durable job runs and
# error reports. Falls back to RENDER_GIT_COMMIT, then GITHUB_SHA, then "local".
SHARK_RELEASE=

# Set by the hosting platform, never by hand. RENDER_EXTERNAL_URL is added to
# the allowed origins.
#RENDER_EXTERNAL_URL=https://shark-fitness.onrender.com
#RENDER_GIT_COMMIT=
#GITHUB_SHA=

# Bounded operational-history retention. Undelivered outbox rows and immutable
# business/audit ledgers are never eligible for this maintenance job.
SHARK_IDEMPOTENCY_RETENTION_DAYS=30
SHARK_OUTBOX_RETENTION_DAYS=7
SHARK_SESSION_RETENTION_DAYS=30
SHARK_OTP_RETENTION_HOURS=24
SHARK_ACCESS_WINDOW_RETENTION_HOURS=24
SHARK_AUTOMATION_RETENTION_DAYS=90
SHARK_JOB_RUN_RETENTION_DAYS=30
SHARK_PRUNE_BATCH_SIZE=1000
SHARK_PRUNE_MAX_BATCHES=10

# Sign-in code delivery. "log" prints codes to the console in development only;
# production refuses code sign-in on a channel whose provider is "log". A
# provider selected without its credentials is refused at boot. These OTP
# variables treat an empty value as unset.
# SMS/WhatsApp: log | msg91 | twilio. Email: log | resend.
SHARK_OTP_SMS_PROVIDER=log
SHARK_OTP_EMAIL_PROVIDER=log
# Country code used when a stored phone has no "+" prefix.
SHARK_OTP_DEFAULT_COUNTRY_CODE=91
# MSG91 (India): DLT-approved OTP template containing ##OTP##.
SHARK_MSG91_AUTH_KEY=
SHARK_MSG91_TEMPLATE_ID=
# Twilio: set SHARK_TWILIO_CHANNEL=whatsapp for WhatsApp. WhatsApp needs an
# approved template (SHARK_TWILIO_CONTENT_SID) whose {{1}} is the code.
SHARK_TWILIO_ACCOUNT_SID=
SHARK_TWILIO_AUTH_TOKEN=
SHARK_TWILIO_FROM=
SHARK_TWILIO_CHANNEL=sms
SHARK_TWILIO_CONTENT_SID=
# Resend email.
SHARK_RESEND_API_KEY=
SHARK_OTP_EMAIL_FROM=
# Send limits (defaults shown). Whole numbers; anything else is refused at boot.
SHARK_OTP_RESEND_COOLDOWN_SEC=30
SHARK_OTP_MAX_PER_DESTINATION_PER_DAY=10
SHARK_OTP_MAX_PER_IP_PER_HOUR=30

# ——— Public website (apps/website). Read by `astro build`, not by the API. ———
# Absolute origin for canonical URLs, Open Graph and the sitemap.
SITE_URL=https://www.sharkfitness.example
# Search engines may index the site only when this is exactly true.
SITE_INDEXABLE=false
# The gym whose public API the website reads and writes (/v1/public/<slug>).
SHARK_SITE_TENANT=shark
# Optional self-hosted analytics script; empty means nothing third-party loads.
SITE_ANALYTICS_SRC=
SITE_ANALYTICS_DOMAIN=
# Dev only: where `astro dev` proxies /v1, and where sync-content reads from.
SHARK_API_URL=http://localhost:8787

# Web Push (member app notifications). Leave all three empty to switch push
# off: the app then shows no notification settings and nothing is queued.
# Generate a pair with `pnpm -F @shark/api vapid:keys`; keep the private key
# out of the repository. The subject is a mailto: or https: contact the push
# services (Google, Apple, Mozilla, Microsoft) can use about abuse.
SHARK_VAPID_PUBLIC_KEY=
SHARK_VAPID_PRIVATE_KEY=
SHARK_VAPID_SUBJECT=
# Testing only: extra push endpoint origins allowed besides the browser push
# services (a local fake push service). Leave empty in every real deployment.
SHARK_PUSH_EXTRA_ENDPOINT_ORIGINS=

# Android Trusted Web Activity (docs/MOBILE-APP.md). Both set, or neither.
# Package id of the Play Store app, and the SHA-256 fingerprint(s) of its
# signing certificate from Play Console > App integrity (comma-separated when
# there is an upload key and a Play App Signing key). Unset serves a 404 at
# /.well-known/assetlinks.json.
SHARK_ANDROID_PACKAGE=
SHARK_ANDROID_CERT_SHA256=
