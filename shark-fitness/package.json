{
  "name": "shark-fitness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,member,admin -c cyan,magenta,yellow \"pnpm -F @shark/api dev\" \"pnpm -F @shark/member-pwa dev\" \"pnpm -F @shark/admin-web dev\"",
    "db:migrate": "pnpm -F @shark/api migrate",
    "db:seed": "pnpm -F @shark/api seed",
    "db:reset": "pnpm -F @shark/api reset",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "concurrently": "9.1.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
