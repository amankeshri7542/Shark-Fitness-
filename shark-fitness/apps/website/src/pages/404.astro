---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="That page does not exist on the Shark Fitness website." path="/404" noindex>
  <section class="hero hero--page">
    <div class="wrap">
      <p class="label label--accent">404</p>
      <h1>Nothing at this depth.</h1>
      <p class="lede">That page does not exist, or it has moved. Members looking for the app will find it at <a href="/app/">/app</a>.</p>
      <div class="actions">
        <a class="btn btn--primary" href="/">Go to the home page</a>
        <a class="btn" href="/free-trial">Book a free trial</a>
      </div>
    </div>
  </section>
</Layout>
