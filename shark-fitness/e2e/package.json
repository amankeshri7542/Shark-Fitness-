{
  "name": "@shark/e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "node run.mjs",
    "e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p audit",
    "store-screenshots": "playwright test --config playwright.capture.config.ts",
    "test": "node --test audit/test/",
    "audit": "node audit/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.65.1",
    "@types/node": "22.10.7",
    "otpauth": "9.6.0",
    "typescript": "5.7.3"
  }
}
