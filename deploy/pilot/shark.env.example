# Shark Fitness pilot settings. provision.sh copies this to
# /srv/shark-fitness/shark.env (mode 600), filling in SHARK_DOMAIN and a fresh
# SHARK_PASS_SECRET. Edit that copy on the server; never commit it.
#
# An optional variable must be absent or commented out, not left empty: the app
# refuses to start on an empty value. Every variable is described in
# shark-fitness/docs/PILOT-HOSTING.md.
#
# Fixed values (NODE_ENV, SHARK_DB, SHARK_SEED_DEMO, SHARK_ECHO_OTP,
# SHARK_ALLOW_BEARER_AUTH, SHARK_TRUST_PROXY_HOPS, SHARK_PUBLIC_ORIGIN, PORT,
# SHARK_SERVE_STATIC) live in compose.yaml and override anything set here.

# Hostname members and staff open, without https://. Its A record must point
# at this server before Caddy can get a certificate.
SHARK_DOMAIN=pilot.example.com

# At least 48 bytes. Generate with: openssl rand -base64 48
SHARK_PASS_SECRET=

# Unexpected server errors are POSTed here as JSON (redacted, no member data).
# A private ntfy.sh topic turns them into phone notifications; use a long
# random topic name, since anyone who knows it can read the topic.
#SHARK_ERROR_REPORTING_ENDPOINT=https://ntfy.sh/shark-pilot-REPLACE-WITH-RANDOM

# backup.sh: healthchecks.io ping URL for the nightly backup. A missed or
# failed night emails you.
#SHARK_BACKUP_PING_URL=https://hc-ping.com/REPLACE-WITH-CHECK-UUID

# backup.sh: days of backups kept on this server.
SHARK_BACKUP_KEEP_DAYS=14
